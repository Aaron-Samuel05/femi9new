// Femi9 production schema — implements PRD §6 (Data model).
// Provider: PostgreSQL. ORM: Prisma. Ids are cuid strings.
//
// Grouped: Catalog · Identity/Auth · Commerce · Loyalty & programs ·
// Community · Cycle & content · Platform settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  customer
  affiliate
  partner
  staff
  admin
}

enum ProductType {
  pad
  panty
  // Lumi9. The enum is shared because the schema is: one definition, one client
  // generator, a database schema per brand. A brand simply never uses the other
  // brand's values.
  diaper
}

enum ProductStatus {
  active
  draft
  archived
}

enum VariantKind {
  pack
  size
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

enum CouponType {
  flat
  pct
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum AffiliateStatus {
  pending
  approved
  suspended
}

enum AffiliateEventType {
  click
  signup
  order
}

enum PayoutStatus {
  pending
  paid
}

enum PartnerStatus {
  new
  contacted
  onboarded
  rejected
}

enum ModerationStatus {
  pending
  approved
  hidden
}

// ────────────────────────────── Catalog ──────────────────────────────

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  type            ProductType   @default(pad)
  basePrice       Int // rupees, integer paise-free (matches current data)
  meta            String // e.g. "9 pads · 330mm"
  flow            String // e.g. "Heavy · Night + Day"
  description     String
  longDescription String?
  tag             String?
  tagClass        String?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  status          ProductStatus @default(active)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  variants   ProductVariant[]
  images     ProductImage[]
  features   ProductFeature[]
  specs      ProductSpec[]
  reviews    Review[]
  wallPosts  WallPost[]
  zonePrices ZoneProductPrice[]
}

model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      VariantKind // pack (pads) | size (panties)
  label     String // "9 pcs" | "M"
  packCount Int? // pads
  size      String? // panties
  price     Int
  sku       String?     @unique
  stock     Int         @default(0)
  active    Boolean     @default(true)

  cartItems     CartItem[]
  orderItems    OrderItem[]
  subscriptions Subscription[]
  zonePrices    ZoneVariantPrice[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductFeature {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  body      String
  position  Int     @default(0)

  @@index([productId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  position  Int     @default(0)

  @@index([productId])
}

model Cadence {
  id       String  @id @default(cuid())
  code     String  @unique // "cycle" | "4w" | "6w"
  label    String
  sub      String
  days     Int
  active   Boolean @default(true)
  position Int     @default(0)

  subscriptions Subscription[]
}

// ─────────────────────────── Identity & Auth ──────────────────────────
// Auth.js (NextAuth) core models, extended with Femi9 fields on User.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  phone         String?   @unique
  // Symmetric with emailVerified. An unverified phone on User is worse than no
  // phone at all — checkout attribution and Thara's anti-self-referral guard both
  // treat phone as an identity — so only a passed OTP challenge stamps this.
  phoneVerified DateTime?
  image         String?
  role          Role      @default(customer)
  tier          String? // "Bloom member"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cycleDataConsent Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  carts         Cart[]
  orders        Order[]
  subscriptions Subscription[]
  points        PointsLedger[]
  coupons       Coupon[]
  affiliate     Affiliate?
  periods       PeriodLog[]
  symptoms      SymptomLog[]
  reviews       Review[]
  wallPosts     WallPost[]
  wallLikes     WallLike[]
  wallReplies   WallReply[]
  events        EventLog[]
  notifications NotificationLog[]

  tharaMembership       TharaMembership?
  tharaReferralReceived TharaReferral?            @relation("TharaReferralReceived")
  tharaCreditLedger     TharaCreditLedger[]       @relation("TharaCreditLedgerUser")
  tharaPointsLedger     TharaRewardPointsLedger[] @relation("TharaPointsLedgerUser")
  tharaVouchers         TharaVoucher[]            @relation("TharaVoucherUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  line      String
  city      String
  state     String?
  pincode   String?
  phone     String?
  isPrimary Boolean @default(false)
  // Soft delete. An address referenced by Order.addressId can never be hard
  // deleted without breaking that order, so removing it from the address book
  // stamps this instead; every account read filters on archivedAt IS NULL.
  archivedAt DateTime?

  orders Order[]

  @@index([userId])
  @@index([userId, archivedAt])
}

// ────────────────────────────── Commerce ──────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestToken String?    @unique // cookie token for anonymous carts
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  qty       Int            @default(1)

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id                 String           @id @default(cuid())
  orderNo            String           @unique
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  status             OrderStatus      @default(pending)
  subtotal           Int
  discount           Int              @default(0)
  shipping           Int              @default(0)
  total              Int
  addressId          String?
  address            Address?         @relation(fields: [addressId], references: [id])
  couponId           String?
  coupon             Coupon?          @relation(fields: [couponId], references: [id])
  affiliateId        String?
  affiliate          Affiliate?       @relation(fields: [affiliateId], references: [id])
  tharaQualifyingFor TharaMembership?          @relation("TharaQualifyingOrder")
  tharaCreditLedger  TharaCreditLedger[]       @relation("TharaCreditLedgerOrder")
  tharaPointsLedger  TharaRewardPointsLedger[] @relation("TharaPointsLedgerOrder")
  channel            String           @default("web") // web | whatsapp
  placedAt           DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items    OrderItem[]
  payments Payment[]
  events   AffiliateEvent[]
  points   PointsLedger[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String // snapshot at purchase
  variantLabel String // snapshot at purchase
  unitPrice    Int // snapshot at purchase
  qty          Int
  lineTotal    Int

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  amount            Int
  status            PaymentStatus @default(created)
  method            String?
  signatureVerified Boolean       @default(false)
  raw               Json?
  createdAt         DateTime      @default(now())

  @@index([orderId])
}

model Coupon {
  id        String     @id @default(cuid())
  code      String     @unique
  type      CouponType
  value     Int
  minOrder  Int        @default(0)
  maxUses   Int? // null = unlimited
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  // A coupon minted by redeeming Bloom points belongs to the customer who paid
  // for it; null means a public/campaign code anyone may use. SetNull (not
  // Cascade) so deleting a user never voids an order's coupon row.
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([userId])
}

model Subscription {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant     @relation(fields: [variantId], references: [id])
  qty            Int                @default(1)
  cadenceId      String
  cadence        Cadence            @relation(fields: [cadenceId], references: [id])
  status         SubscriptionStatus @default(active)
  nextDeliveryAt DateTime
  savedTotal     Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([status, nextDeliveryAt])
}

// ─────────────────────────── Loyalty & programs ────────────────────────

model PointsLedger {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int // +earn / -redeem
  reason       String
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([userId])
}

model RewardOption {
  id          String     @id @default(cuid())
  title       String
  costPoints  Int
  couponType  CouponType
  couponValue Int
  active      Boolean    @default(true)
  position    Int        @default(0)
}

model Affiliate {
  id           String          @id @default(cuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle       String
  platform     String?
  followerBand String?
  promoCode    String          @unique
  status       AffiliateStatus @default(pending)
  payoutUpi    String?
  createdAt    DateTime        @default(now())

  events  AffiliateEvent[]
  payouts AffiliatePayout[]
  orders  Order[]
}

model AffiliateEvent {
  id          String             @id @default(cuid())
  affiliateId String
  affiliate   Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  type        AffiliateEventType
  orderId     String?
  order       Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount      Int                @default(0)
  commission  Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([affiliateId])
}

model AffiliatePayout {
  id          String       @id @default(cuid())
  affiliateId String
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Int
  status      PayoutStatus @default(pending)
  periodStart DateTime
  periodEnd   DateTime
  reference   String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([affiliateId])
}

model PartnerApplication {
  id        String        @id @default(cuid())
  name      String
  phone     String
  city      String
  situation String?
  reason    String?
  status    PartnerStatus @default(new)
  notes     String?
  createdAt DateTime      @default(now())

  @@index([status])
}

// ────────────────────────────── Community ─────────────────────────────

model WallPost {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  alias       String?
  isAnonymous Boolean          @default(false)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  rating      Int?
  body        String
  tags        String[]
  status      ModerationStatus @default(pending)
  likeCount   Int              @default(0)
  createdAt   DateTime         @default(now())

  likes   WallLike[]
  replies WallReply[]

  @@index([status])
}

model WallLike {
  id        String   @id @default(cuid())
  postId    String
  post      WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model WallReply {
  id        String   @id @default(cuid())
  postId    String
  post      WallPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model Review {
  id        String           @id @default(cuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  place     String?
  rating    Int
  // Optional one-line headline ("Loved this combo"). Nullable because every row
  // written before this column existed has none, and the card falls back to the
  // rating's own wording rather than printing an empty heading.
  title     String?
  body      String
  status    ModerationStatus @default(approved)
  // Denormalised helpful/unhelpful tallies. Counters rather than a join on
  // ReviewVote because the product page reads them for every card on every
  // render and never needs to know WHO voted — only ReviewVote does, and only
  // to stop one visitor voting twice.
  helpfulUp   Int @default(0)
  helpfulDown Int @default(0)
  createdAt DateTime         @default(now())

  votes ReviewVote[]

  @@index([productId])
}

/**
 * One vote per visitor per review. `voterKey` is a signed-in user id when we
 * have one and an IP-derived hash otherwise, so the unique constraint is what
 * enforces "vote once" — a client-side guard alone is a localStorage clear away
 * from being meaningless.
 */
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  voterKey  String
  helpful   Boolean
  createdAt DateTime @default(now())

  @@unique([reviewId, voterKey])
  @@index([reviewId])
}

// ─────────────────────────── Cycle & content ──────────────────────────

model PeriodLog {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate     DateTime? // legacy plaintext; migration clears after encryption
  lengthDays    Int? // legacy plaintext; migration clears after encryption
  encryptedData String? // AES-256-GCM period payload
  // HMAC-SHA256(CYCLE_DATA_ENCRYPTION_KEY, `${userId}|${YYYY-MM-DD}`) — an HMAC,
  // never the plaintext day, because a readable start-date column would defeat
  // the point of encrypting the payload. Two rows with the same start produced
  // a gap of 0 → avgCycle 0 → NaN across the whole dashboard, so it is @@unique.
  // Legacy rows keep NULL and Postgres treats NULLs as distinct, so no backfill.
  startDayHash  String?
  createdAt     DateTime  @default(now())

  @@unique([userId, startDayHash])
  @@index([userId])
}

model SymptomLog {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime? // legacy plaintext; migration clears after encryption
  symptom       String? // legacy plaintext; migration clears after encryption
  level         Int? // legacy plaintext; migration clears after encryption
  encryptedData String? // AES-256-GCM symptom payload
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model BlogCategory {
  id    String @id @default(cuid())
  name  String @unique
  color String
  tint  String

  posts BlogPost[]
}

model BlogPost {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  categoryId  String
  category    BlogCategory     @relation(fields: [categoryId], references: [id])
  excerpt     String
  author      String
  readTime    Int              @default(4)
  tone        String
  image       String?
  featured    Boolean          @default(false)
  status      ModerationStatus @default(approved)
  body        String[] // paragraphs / '## ' headings / '> ' pull-quotes
  publishedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

// Both newsletter forms (footer + journal) showed "you're on the list" while
// discarding the address. This is where they land now. Deliberately NOT a User —
// a subscriber has no account and must be removable without touching identity.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // 'footer' | 'journal'
  createdAt DateTime @default(now())
}

model EventLog {
  id        String   @id @default(cuid())
  type      String // view | add_to_cart | checkout | signup | ...
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel   String
  recipient String
  template  String
  dedupeKey String   @unique
  status    String
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ────────────────────────── Platform settings ─────────────────────────
// Editable business config — replaces hardcoded FREE_SHIP / SUBSCRIBE_PCT etc.

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ────────────────────────── Regional pricing ──────────────────────────
// A PriceZone is a named pricing bucket (e.g. "Tamil Nadu") that applies a
// discount off the base price. Regions are attached via ZoneRegion — STATES
// now, DISTRICTS / PINCODE prefixes later WITHOUT a schema change. Pricing is
// per-zone and resolved server-side; the isDefault zone is the fallback shown
// when a visitor's location is unknown.
//
// A zone prices in one of two ways, and the second one WINS where it is set:
//   1. `discountPct` — a blanket percentage off every product in the zone.
//   2. ZoneProductPrice / ZoneVariantPrice — an EXACT rupee price the admin
//      typed for one product (its card price) or one variant (what a cart line
//      is charged). These are the "custom price setter": where a row exists the
//      percentage is not consulted at all, so a zone can be priced item by item
//      rather than only marked down as a whole.

enum RegionKind {
  state
  district
  pincode
}

model PriceZone {
  id          String   @id @default(cuid())
  name        String   @unique
  discountPct Int      @default(0) // 0–100, percent off the base price
  isDefault   Boolean  @default(false)
  active      Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions       ZoneRegion[]
  productPrices ZoneProductPrice[]
  variantPrices ZoneVariantPrice[]
}

model ZoneRegion {
  id     String     @id @default(cuid())
  zoneId String
  zone   PriceZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  kind   RegionKind @default(state)
  value  String // "Tamil Nadu" (state) · "Coimbatore" (district) · "641" (pincode prefix)

  @@unique([kind, value]) // a region maps to at most one zone (no ambiguity)
  @@index([zoneId])
}

// An exact price for ONE PRODUCT in one zone — the number on the card and the
// product page's headline. It does NOT cascade down to the product's variants:
// a pack of 9 and a pack of 18 are different money, so each variant carries its
// own row below. Deleting the product or the zone removes the override with it.
model ZoneProductPrice {
  id        String    @id @default(cuid())
  zoneId    String
  zone      PriceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int // whole rupees, as typed by the admin

  @@unique([zoneId, productId]) // one price per product per zone
  @@index([productId])
}

// An exact price for ONE VARIANT in one zone. This is the row that decides real
// money: cart lines, checkout and subscription renewals all price a variant.
model ZoneVariantPrice {
  id        String         @id @default(cuid())
  zoneId    String
  zone      PriceZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price     Int // whole rupees, as typed by the admin

  @@unique([zoneId, variantId]) // one price per variant per zone
  @@index([variantId])
}

// An IPv6 prefix that has been OBSERVED to serve one Indian telecom circle.
//
// Why this table exists: mobile carriers CGNAT their IPv4, so the address the CDN
// resolves is a regional gateway and not the shopper — which is why regional
// pricing misfires on Jio/Airtel and works over WiFi. They do NOT NAT IPv6, and
// its prefixes are allocated per licensed service area ("telecom circle"), which
// is drawn on state lines. The prefix therefore still carries roughly the
// granularity a zone needs.
//
// It ships EMPTY on purpose. No registry publishes prefix→circle, so the rows are
// LEARNED: every order pairs the viewer's IP with a delivery pincode the shopper
// typed, which is ground truth. `observations` counts the confirmed deliveries
// behind a row, and src/lib/geo/circles.ts refuses to price from a row until it
// clears a threshold — one order proves nothing. Guessing prefixes by hand would
// misprice real shoppers, which is worse than the bug being fixed.
model IpCircleRange {
  id     String @id @default(cuid())
  // Nibble-aligned IPv6 prefix key, e.g. "24052011/32" — hex nibbles, then the
  // length in bits. Prisma cannot express Postgres `inet` containment, so the
  // lookup probes a fixed set of lengths and takes the longest hit instead.
  prefix String @unique
  // Circle slug from TELECOM_CIRCLES in src/lib/geo/circles.ts ("tamil-nadu").
  // Several circles span more than one state and yield no state at all.
  circle String
  // The carrier this prefix belongs to, when known. Diagnostic only.
  asn    Int?

  // Confirmed deliveries backing this row, and how much they agree. A prefix
  // that has shipped to its circle 200 times out of 210 is trustworthy; 3 out of
  // 5 is noise. `active` lets ops retire a row that has started lying without
  // deleting the evidence.
  observations Int     @default(0)
  conflicts    Int     @default(0)
  active       Boolean @default(true)
  // "observed" (learned from orders) | "manual" (an admin typed it).
  source       String  @default("observed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circle])
  @@index([asn])
}

// ─────────────────────────── Thara Model ───────────────────────────
// Sub-project A: identity spine (enrolment + attribution). Sub-projects
// B–F (personal discount, wallet credit, points, invite email, dashboards)
// read from these tables; they do not modify them.

enum TharaStatus {
  purchase_pending
  active
  suspended
  deactivated
}

model TharaMembership {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status            TharaStatus @default(purchase_pending)
  enrolledAt        DateTime    @default(now())
  activatedAt       DateTime?
  qualifyingOrderId String?     @unique
  qualifyingOrder   Order?      @relation("TharaQualifyingOrder", fields: [qualifyingOrderId], references: [id])

  referralCode    String   @unique
  termsAcceptedAt DateTime
  termsVersion    String

  suspendedAt         DateTime?
  suspendedReason     String?
  statusBeforeSuspend TharaStatus?
  deactivatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralsMade TharaReferral[] @relation("Referrer")

  @@index([status])
  @@index([referralCode])
}

/// A three-month reward cycle (Benefit 3). Points accumulate against the
/// currently-open cycle; a cron closes it, sums, and issues vouchers.
enum TharaCycleStatus {
  open
  closed
}

model TharaCycle {
  id        String            @id @default(cuid())
  startDate DateTime // inclusive
  endDate   DateTime // inclusive
  status    TharaCycleStatus  @default(open)
  closedAt  DateTime?
  createdAt DateTime          @default(now())

  points   TharaRewardPointsLedger[]
  vouchers TharaVoucher[]

  @@unique([startDate, endDate])
  @@index([status])
}

/// Append-only ledger of Thara reward points (Benefit 3: 1% commission).
/// Every accrual and reversal is a row. Points sum per (userId, cycleId).
model TharaRewardPointsLedger {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation("TharaPointsLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  cycleId       String
  cycle         TharaCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  delta         Int // points; +earn / -reversal
  reason        String // 'referral-points' | 'refund-reversal'
  sourceOrderId String?
  sourceOrder   Order?     @relation("TharaPointsLedgerOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([userId, cycleId])
  @@index([sourceOrderId])
}

/// Amazon voucher issued at cycle close. Points × multiplier (default 3) = ₹.
enum TharaVoucherStatus {
  available
  claimed
  expired
  cancelled
}

model TharaVoucher {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation("TharaVoucherUser", fields: [userId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          TharaCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  points         Int // snapshot of the total the cycle closed with
  valuePaise     Int // points × multiplier × 100
  amazonCode     String?             @unique
  status         TharaVoucherStatus  @default(available)
  issuedAt       DateTime            @default(now())
  claimDeadline  DateTime // hard expiry
  claimedAt      DateTime?

  @@unique([userId, cycleId])
  @@index([status])
}

/// Hard-bounce / complaint list for Thara invite emails. Populated by the
/// Resend webhook. Any address in here is refused by sendTharaInvite.
model TharaSuppressedEmail {
  email     String   @id
  reason    String // 'hard_bounce' | 'complaint' | 'manual'
  createdAt DateTime @default(now())
}

/// Append-only ledger of Femi9 store credit (Benefit 2: 10% commission).
/// Every accrual, spend and refund reversal is a row. Balance = SUM(delta).
model TharaCreditLedger {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("TharaCreditLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  delta         Int // paise; +earn / -spend / +/-reversal
  reason        String // 'referral-commission' | 'checkout-spend' | 'refund-reversal'
  sourceOrderId String?
  sourceOrder   Order?   @relation("TharaCreditLedgerOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  balanceAfter  Int // snapshot for auditability
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([sourceOrderId])
}

model TharaReferral {
  id         String          @id @default(cuid())
  referrerId String
  referrer   TharaMembership @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  referredUserId String @unique
  referred       User   @relation("TharaReferralReceived", fields: [referredUserId], references: [id], onDelete: Cascade)

  attributedAt DateTime  @default(now())
  lockedAt     DateTime?

  invitedByEmail String?
  invitedByLink  Boolean @default(false)
  ipAtSignup     String?
  uaAtSignup     String?

  createdAt DateTime @default(now())

  @@index([referrerId])
}
