{
  "version": 2,
  "framework": null,
  "installCommand": "cd femi9-react && npm install",
  "buildCommand": "cd femi9-react && npm run build",
  "outputDirectory": "femi9-react/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/product/:path*", "destination": "/index.html" },
    { "source": "/product-options/:path*", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ]
}
