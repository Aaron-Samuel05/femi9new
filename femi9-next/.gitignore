# dependencies
/node_modules
# next
/.next/
/out/
# production
/build
# env
.env
.env*.local
# misc
.DS_Store
*.pem
npm-debug.log*
*.log
/.npm-cache/
/.next-swc-cache/
*.tsbuildinfo
# prisma
/prisma/*.db

# GeoLite2 databases — downloaded by scripts/fetch-geoip.mjs, never committed.
# They are large binaries under MaxMind's licence, and they go stale; the image
# build fetches its own copy. See docs/GEOIP.md.
/data/geoip/*.mmdb
/data/geoip/*.partial

# Terraform local state and operator values contain generated DB/auth secrets.
/infra/terraform/.terraform/
/infra/terraform/*.tfstate
/infra/terraform/*.tfstate.*
/infra/terraform/*.tfvars
!/infra/terraform/*.tfvars.example
/infra/terraform/*.plan
/infra/terraform/femi9.plan
/infra/terraform/backend.hcl
/infra/terraform/state-bootstrap/*.tfstate
/infra/terraform/state-bootstrap/*.tfstate.*
/infra/terraform/state-bootstrap/.terraform/

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
