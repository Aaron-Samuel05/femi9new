# Workspace-level ignores. Each app keeps its own .gitignore for app-specific
# artifacts; this file covers what the monorepo root and tooling produce.

node_modules/
.turbo/
.local-pg-data/

# Next.js build output, wherever it lands in the workspace
.next/
out/

# Local env files never belong in git — .env.example is the contract.
.env
.env.local
.env.*.local

# Logs and OS cruft
*.log
.DS_Store

# ── Platform Terraform stack (infra/terraform) ───────────────────────────────
# State embeds the GENERATED Aurora password and every connection string built
# from it, and tfvars carries account-specific values. Neither belongs in git;
# state lives in the encrypted, locked S3 backend (see infra/terraform/README.md).
# `.terraform.lock.hcl` is deliberately NOT ignored — pinning provider hashes is
# the point of it.
/infra/terraform/.terraform/
/infra/terraform/*.tfstate
/infra/terraform/*.tfstate.*
/infra/terraform/*.tfvars
!/infra/terraform/*.tfvars.example
/infra/terraform/*.plan
/infra/terraform/backend.hcl
#
# A PLAN is as sensitive as state and is easier to leave lying around. `plan.json`
# and its variants carry `master_password` — the generated Aurora credential —
# and `secret_string` for every Secrets Manager value the stack manages;
# `terraform show -json` output carries the same. They are working files nobody
# thinks of as secrets, they accumulate one debugging session at a time
# (plan.json, plan-nr.json, plan-lumi9.json, state-now.json, tfplan-check.out…),
# and `*.plan` above matched none of them because nothing here is named `.plan`.
#
# This matters more since `lumi9` became the auto-deploying branch: one
# `git add -A` would push the database password to a public repo AND ship a
# release in the same command.
/infra/terraform/*.json
/infra/terraform/*.out
/infra/terraform/*.bak

# Raw 3D source drops. The 22 MB Tripo export at the root is the INPUT to the
# gltf-transform pipeline; only the optimised result belongs in git, under
# apps/*/public/assets. Committing the source would pin 22 MB into history.
/*.glb.txt

# Hallmark design-pass scratch log — tooling output, not project history.
.hallmark/

# A local env drop that the `.env*` patterns miss: the file is named `env`, with
# no dot, so nothing above matched it and it showed up as an ordinary untracked
# file holding a live Postgres password. One `git add -A` would have published
# the credential.
/env

# Dev image uploads. `/<brand>/api/upload` falls back to writing under the
# console's `public/uploads` when no S3 bucket is configured, so this directory
# fills up with whatever anyone uploaded while testing locally — product photos,
# blog covers, launch-popup GIFs. In production those bytes are in S3 and this
# path holds nothing; committing them would pin megabytes of scratch artwork
# into history for files no deployed image ever reads.
/apps/*/public/uploads/
 
*.zip
!femi9-scrool.zip
