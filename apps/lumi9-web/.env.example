# ─────────────────────────────────────────────────────────────────────────────
# apps/lumi9-web — the contract. Copy to .env and fill in.
#
# `.env` is gitignored. THIS file is the documentation, so every variable added
# to the app belongs here with a comment saying what breaks without it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# The only render-blocking variable. The root layout is force-dynamic and awaits
# loadCatalog() -> getCatalog('lumi9') -> dbFor('lumi9'), which reads this and
# has NO fallback by design (Femi9's bare DATABASE_URL must never satisfy a
# Lumi9 read). Without it every route 500s, including /privacy and /help.
DATABASE_URL_LUMI9="postgresql://user:pass@host:5432/db?schema=lumi9"

# Signs the customer session JWT and keys the /confirmation capability token.
# /account and /checkout 503 without it; /api/health fails closed.
AUTH_SECRET=

# ── Sign-in providers ────────────────────────────────────────────────────────
#
# Checkout is GATED behind sign-in on this brand (see proxy.ts), so "no working
# sign-in method" means nobody can buy — on a site that otherwise looks healthy.
# /api/health reports `authMethods` and warns NO_AUTH_PROVIDER for that reason.
#
# src/lib/auth-methods.ts decides what /login offers: a method is available when
# its provider is configured, or when ALLOW_MOCK_PROVIDERS is on outside
# production. The AUTH_*_ENABLED switches below override that.

# Phone OTP (the primary method). Both are needed for live SMS.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Emailed sign-in link. Brand-suffixed names win over the bare ones, so the two
# brands can send from different domains without either inheriting the other's.
RESEND_API_KEY_LUMI9=
EMAIL_FROM_LUMI9=

# Google. GOOGLE_REDIRECT_URI is the one that bites: Google compares it
# BYTE-FOR-BYTE with a URI registered on the OAuth client, and it is a single
# value that beats everything else. Sharing one OAuth client between the brands
# is fine; inheriting one redirect URI is not — Lumi9 must name its OWN host, or
# the consent screen answers redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://<this-app-host>/api/auth/google/callback"

# ── Sign-in kill switches ────────────────────────────────────────────────────
#
# Unset (the default) means "follow the provider probe", which is what you want
# almost always: configure MSG91 and phone sign-in turns itself on. ONLY the
# exact string `false` disables — anything else is ignored rather than guessed
# at, because a typo must not quietly remove a sign-in method from a live site.
#
# These exist for what detection cannot see. Google is the case in point: a
# client id and secret being present makes googleConfigured() true while the
# flow is still broken, because what is wrong is the redirect URI. Detection
# answers "is it set up?"; the switch answers "do we want it on?".
#
# Turning off the LAST remaining method is refused — the emailed link is forced
# back on and health warns NO_AUTH_PROVIDER, rather than shipping a storefront
# nobody can sign into.
#
# AUTH_GOOGLE_ENABLED=false
# AUTH_PHONE_ENABLED=false
# AUTH_EMAIL_ENABLED=false

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID_LUMI9=
RAZORPAY_KEY_SECRET_LUMI9=
RAZORPAY_WEBHOOK_SECRET_LUMI9=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
#
# Compared in constant time by @femi9/core/cron-auth, which treats Terraform's
# `TODO-` placeholder as unset. Without it renew-subscriptions cannot run, and a
# subscription ships one box and then nothing forever while the account page
# keeps showing a next-delivery date.
CRON_SECRET=

# ── Origins ──────────────────────────────────────────────────────────────────

# Owns canonicals, OG URLs, sitemap.xml, robots.txt and every JSON-LD @id.
# Server-only and read at RUNTIME on purpose: Next inlines every NEXT_PUBLIC_*
# reference at BUILD time, and the Docker build stage has no deploy config, so a
# public name would bake whatever the build happened to see into the image.
# Any origin that is not the canonical one serves Disallow: / and noindex.
SITE_URL="https://thelumi9.com"

# The origin baked into emailed sign-in links, and the fallback the verify
# redirect uses. Public because the link is built for a browser to follow.
NEXT_PUBLIC_SITE_URL="https://thelumi9.com"

# ── Local development only ───────────────────────────────────────────────────
#
# Makes the OTP and magic-link seams NO-OP and return devCode / devLink instead
# of calling a provider, so the whole sign-in flow is exercisable without an SMS
# bill. Honoured ONLY when NODE_ENV !== "production" — it can never become an
# authentication bypass on a deployed task.
# ALLOW_MOCK_PROVIDERS=true

NEXT_TELEMETRY_DISABLED=1
