# =============================================================================
# Build context for apps/lumi9-web/Dockerfile.
#
# BuildKit looks for `<dockerfile-path>.dockerignore` before falling back to the
# context root's .dockerignore, so this file — not the root one — governs a
# `docker build -f apps/lumi9-web/Dockerfile .`.
#
# That indirection is the whole point. The root .dockerignore was written for
# Femi9 and excludes `apps/lumi9-web/**`; a Lumi9 build under it would produce
# an image containing no application. Rather than loosen the root file (and so
# change Femi9's context, its layer cache, and its blast radius), each brand
# now brings its own. Femi9's build still reads the root file and is byte-for-
# byte unaffected.
#
# The mirror image of the root file: keep THIS brand, drop the other one.
# =============================================================================

# Dependencies & build output — reinstalled/rebuilt inside the image.
**/node_modules
**/.next
**/.turbo
out
dist
build

# Version control & CI metadata.
.git
.gitignore
.github

# Local env / secrets — MUST NOT leak into an image layer.
# `next build` traces .env into the standalone bundle when it is present, so
# this exclusion is what keeps developer credentials out of the image.
**/.env
**/.env.*

# Terraform state and variable files.
**/infra/terraform/.terraform
**/infra/terraform/*.tfstate
**/infra/terraform/*.tfstate.*
**/infra/terraform/*.tfvars
**/infra/terraform/*.plan
**/infra/terraform/backend.hcl
**/infra/terraform/state-bootstrap/.terraform
**/infra/terraform/state-bootstrap/*.tfstate
**/infra/terraform/state-bootstrap/*.tfstate.*

# Tests, coverage, and TS build cache — not needed to run the app.
**/test
**/tests
**/__tests__
**/coverage
**/*.tsbuildinfo
**/vitest.config.ts
**/playwright.config.ts
**/playwright-report
**/test-results

# Local SQLite / Prisma dev artifacts. The schema and migrations ARE kept — the
# entrypoint runs `prisma migrate deploy` against them on boot.
**/prisma/*.db
**/prisma/*.db-journal

# Docs & markdown.
**/*.md
**/docs
*.pdf

# Docker files themselves — not needed inside the image.
**/Dockerfile
**/*.dockerignore
**/docker-compose.yml
**/docker-compose*.yml

# ── Legacy prototypes at the repo root ───────────────────────────────────────
# Superseded by apps/femi9-web. Dead code, and none of it belongs in an image.
femi9-app
femi9-react
femi9-scrool
femi9-lavender
femi9-scrool.zip
assets
Images
index.html
app.js
styles.css

# ── The other brand, and the console ─────────────────────────────────────────
# Each is a separate image. Their SOURCE is excluded, but their package.json is
# re-included: `npm ci` reconciles the root lockfile against every workspace
# manifest and fails on one it cannot find. Excluding a directory's *contents*
# (`/**`) rather than the directory itself is what makes the negation work.
apps/femi9-web/**
!apps/femi9-web/package.json
apps/admin/**
!apps/admin/package.json

# db-platform is admin identity — nothing in this image reads it. Same
# treatment: manifest in, source out. Its `generated/` client is a build
# artifact and is not in git anyway.
packages/db-platform/**
!packages/db-platform/package.json

# Editor / OS cruft.
**/.vscode
**/.idea
**/.DS_Store
**/*.pem
**/npm-debug.log*
**/yarn-error.log*
**/*.log
