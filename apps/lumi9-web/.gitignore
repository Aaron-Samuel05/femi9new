# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the CONTRACT. `.env.example` holds no values, only the variable
# names and what breaks without each one, and it is the only record of them —
# `.env` itself is never committed. femi9-web tracks its equivalent for the
# same reason.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright run output. `npx playwright test` writes a trace, a screenshot and
# an error-context file per failure into test-results/, and the HTML reporter
# writes playwright-report/ - both are artefacts of a run, not project history,
# and a failing local run would otherwise offer them up to the next `git add -A`.
/test-results/
/playwright-report/
