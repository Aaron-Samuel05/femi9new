# dependencies
/node_modules
# next
/.next/
/out/
# production
/build
# env
.env
.env*.local
# misc
.DS_Store
*.pem
npm-debug.log*
*.log
/.npm-cache/
/.next-swc-cache/
*.tsbuildinfo
# prisma
/prisma/*.db

# GeoLite2 databases — downloaded by scripts/fetch-geoip.mjs, never committed.
# They are large binaries under MaxMind's licence, and they go stale; the image
# build fetches its own copy. See docs/GEOIP.md.
/data/geoip/*.mmdb
/data/geoip/*.partial

# Terraform local state and operator values contain generated DB/auth secrets.
/infra/terraform/.terraform/
/infra/terraform/*.tfstate
/infra/terraform/*.tfstate.*
/infra/terraform/*.tfvars
!/infra/terraform/*.tfvars.example
/infra/terraform/*.plan
/infra/terraform/femi9.plan
/infra/terraform/backend.hcl
/infra/terraform/state-bootstrap/*.tfstate
/infra/terraform/state-bootstrap/*.tfstate.*
/infra/terraform/state-bootstrap/.terraform/

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Source testimonial footage (350MB). Only web-sized transcodes are served, and
# those live in S3 (see src/data/videoTestimonials.ts), not in this repo.
Testimonial Videos/

# Dev upload scratch. app/api/admin/upload writes here when S3/Cloudinary are
# unconfigured, and the product-page testimonial clips are dropped here for local
# runs. In staging/prod the same /uploads/* paths are served from S3 through
# CloudFront, so none of this belongs in the repo.
public/uploads/
